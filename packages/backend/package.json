{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../../node_modules/ts-node/dist/bin.js --project tsconfig.json src/index.ts",
    "build": "node ../../node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "migrate": "node ../../node_modules/ts-node/dist/bin.js src/database/migrate.ts",
    "migrate:rollback": "node ../../node_modules/ts-node/dist/bin.js src/database/migrate.ts rollback",
    "seed": "node ../../node_modules/ts-node/dist/bin.js src/database/seed.ts",
    "lint": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test --experimental-test-coverage dist/test/**/*.test.js",
    "test:build": "node ../../node_modules/typescript/bin/tsc && node --test dist/test/**/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.5",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
