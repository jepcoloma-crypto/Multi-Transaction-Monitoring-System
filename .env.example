# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multi_account_monitor
DB_USER=postgres
DB_PASSWORD=postgres
# How many days of nightly 3 AM (Manila) automatic backups to keep.
# Optional; defaults to 15. Only backup_auto_* files are pruned.
BACKUP_RETENTION_DAYS=15
JWT_SECRET=your_secret_key
CORS_ORIGIN=*
PORT=3001

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Frontend
VITE_API_URL=http://localhost:3001/api
